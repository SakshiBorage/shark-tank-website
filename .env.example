# Vercel deploy: connection string from your Neon Postgres integration
# (Vercel dashboard -> Storage -> add Neon -> it injects this automatically;
# for local `vercel dev`, copy it into a .env.local file, or run `vercel env pull`)
DATABASE_URL=postgres://user:password@ep-xxxxxxxx.region.aws.neon.tech/neondb?sslmode=require
